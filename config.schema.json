{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jm-napcat-go configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "upstreamBaseUrl",
    "upstreamTimeoutMs",
    "infoCacheDir",
    "maxTaskQueued",
    "pdfCacheDir",
    "pdfCacheMaxSize",
    "workerPoolSize",
    "maxRetries",
    "errorTtlMs",
    "imageDownloadTimeoutMs",
    "imageDownloadRetries",
    "networkConcurrency",
    "cpuConcurrency",
    "napcatWsUrl",
    "napcatAccessToken",
    "pollIntervalMs",
    "maxPollAttempts",
    "rateLimitWindowMs",
    "rateLimitMaxRequests"
  ],
  "properties": {
    "upstreamBaseUrl": { "type": "string", "minLength": 1, "format": "uri" },
    "upstreamTimeoutMs": { "type": "integer", "minimum": 1 },
    "infoCacheDir": { "type": "string", "minLength": 1 },
    "maxTaskQueued": { "type": "integer", "minimum": 1 },
    "pdfCacheDir": { "type": "string", "minLength": 1 },
    "pdfCacheMaxSize": { "type": "integer", "minimum": 1 },
    "workerPoolSize": { "type": "integer", "minimum": 1 },
    "maxRetries": { "type": "integer", "minimum": 0 },
    "errorTtlMs": { "type": "integer", "minimum": 1 },
    "imageDownloadTimeoutMs": { "type": "integer", "minimum": 1 },
    "imageDownloadRetries": { "type": "integer", "minimum": 1 },
    "networkConcurrency": { "type": "integer", "minimum": 1 },
    "cpuConcurrency": { "type": "integer", "minimum": 1 },
    "napcatWsUrl": { "type": "string", "minLength": 1, "format": "uri" },
    "napcatAccessToken": { "type": "string" },
    "pollIntervalMs": { "type": "integer", "minimum": 1 },
    "maxPollAttempts": { "type": "integer", "minimum": 1 },
    "rateLimitWindowMs": { "type": "integer", "minimum": 1 },
    "rateLimitMaxRequests": { "type": "integer", "minimum": 1 }
  }
}
